{
  "openapi": "3.0.3",
  "info": {
    "title": "Lapticon API",
    "version": "1.0.0",
    "description": "API del backend de Lapticon (encomiendas y viajeros). Generado para el taller de Computación Móvil a partir del código real del backend (rama `education`).",
    "contact": {
      "name": "Lapticon"
    }
  },
  "servers": [
    {
      "url": "https://lapticon-backend-ed.onrender.com",
      "description": "Producción (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID Token",
        "description": "Token obtenido de Firebase Auth (user.getIdToken() en el cliente). Se envía como `Authorization: Bearer <token>`."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "nacionalidad": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          }
        }
      },
      "Viaje": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "uid": {
            "type": "string"
          },
          "numeroVuelo": {
            "type": "string"
          },
          "ciudadOrigen": {
            "type": "string"
          },
          "ciudadDestino": {
            "type": "string"
          },
          "fechaViaje": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "completado",
              "cancelado",
              "contactado"
            ]
          }
        }
      },
      "Encomienda": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "uid": {
            "type": "string",
            "description": "Remitente"
          },
          "ciudadOrigen": {
            "type": "string"
          },
          "ciudadDestino": {
            "type": "string"
          },
          "observaciones": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "tomada",
              "vencida",
              "recibida"
            ]
          },
          "viajeroId": {
            "type": "string",
            "nullable": true
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaVencimiento": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Rating": {
        "type": "object",
        "properties": {
          "usuarioOrigen": {
            "type": "string"
          },
          "usuarioDestino": {
            "type": "string"
          },
          "rolDestino": {
            "type": "string"
          },
          "calificacion": {
            "type": "number"
          },
          "comentario": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "NoAutenticado": {
        "description": "Falta o es inválido el token Bearer",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NoAutorizado": {
        "description": "Token válido, pero no eres dueño del recurso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NoEncontrado": {
        "description": "El recurso no existe",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/users/register": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Registrar o actualizar mi perfil",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "apellido": {
                    "type": "string"
                  },
                  "telefono": {
                    "type": "string"
                  },
                  "fechaNacimiento": {
                    "type": "string",
                    "format": "date"
                  },
                  "nacionalidad": {
                    "type": "string"
                  },
                  "correo": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "nombre": "Ana",
                "apellido": "Gómez",
                "telefono": "3001234567",
                "nacionalidad": "Colombia"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario guardado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/Usuario"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          }
        }
      }
    },
    "/api/users/{uid}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Ver un perfil (solo el dueño)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/Usuario"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualizar un perfil (solo el dueño)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "nombre": "Ana Actualizada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "description": "Se intentó modificar uid o email"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          }
        }
      }
    },
    "/api/viajes": {
      "post": {
        "tags": [
          "Viajes"
        ],
        "summary": "Registrar un viaje",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "numeroVuelo": {
                    "type": "string"
                  },
                  "ciudadOrigen": {
                    "type": "string"
                  },
                  "ciudadDestino": {
                    "type": "string"
                  },
                  "fechaViaje": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "example": {
                "numeroVuelo": "AA123",
                "ciudadOrigen": "Bogota",
                "ciudadDestino": "Miami",
                "fechaViaje": "2026-12-01"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Viaje creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Viaje"
                }
              }
            }
          },
          "400": {
            "description": "Ya existe un viaje disponible para este usuario"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          }
        }
      },
      "get": {
        "tags": [
          "Viajes"
        ],
        "summary": "Listar mis viajes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de viajes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Viaje"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          }
        }
      }
    },
    "/api/viajes/disponible": {
      "get": {
        "tags": [
          "Viajes"
        ],
        "summary": "Mi viaje disponible actual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Viaje disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Viaje"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "404": {
            "description": "No hay viajes disponibles"
          }
        }
      }
    },
    "/api/viajes/buscar": {
      "get": {
        "tags": [
          "Viajes"
        ],
        "summary": "Buscar viajeros por ciudad de origen",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "ciudad",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bogota"
          }
        ],
        "responses": {
          "200": {
            "description": "Viajes encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Viaje"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Falta el parámetro ciudad"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          }
        }
      }
    },
    "/api/viajes/{id}/estado": {
      "patch": {
        "tags": [
          "Viajes"
        ],
        "summary": "Cambiar estado de un viaje (solo el dueño)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "disponible",
                      "completado",
                      "cancelado"
                    ]
                  }
                }
              },
              "example": {
                "estado": "completado"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado actualizado"
          },
          "400": {
            "description": "Estado inválido"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "404": {
            "description": "No encontrado o no autorizado"
          }
        }
      }
    },
    "/api/viajes/disponibles": {
      "get": {
        "tags": [
          "Viajes"
        ],
        "summary": "Buscar viajes disponibles por ruta (pública)",
        "parameters": [
          {
            "name": "ciudadOrigen",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bogota"
          },
          {
            "name": "ciudadDestino",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Miami"
          }
        ],
        "responses": {
          "200": {
            "description": "Viajes disponibles con nombre del viajero"
          },
          "400": {
            "description": "Faltan parámetros de búsqueda"
          }
        }
      }
    },
