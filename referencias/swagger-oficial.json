        ],
        "summary": "Forzar actualización de encomiendas vencidas (pública / tarea programada)",
        "responses": {
          "200": {
            "description": "Encomiendas vencidas actualizadas"
          }
        }
      }
    },
    "/api/encomiendas/evaluar-emparejamiento": {
      "post": {
        "tags": [
          "Encomiendas"
        ],
        "summary": "Consultar motor de IA de emparejamiento (requiere MATCHING_API_URL)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "origen_match": {
                    "type": "string"
                  },
                  "destino_match": {
                    "type": "string"
                  },
                  "dias_diferencia": {
                    "type": "number"
                  },
                  "valor_encomienda": {
                    "type": "number"
                  },
                  "reputacion_viajero": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ match: boolean }"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "500": {
            "description": "Motor de emparejamiento no disponible"
          }
        }
